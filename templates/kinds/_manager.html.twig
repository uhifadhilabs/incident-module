{# ── THE MANAGER (populated) ──────────────────────────────────────────────
   Ruled composition A: kinds on the left, the selected kind's sub-categories on
   the right. A deactivated row is DIMMED (.off), never hidden, never struck
   through. Every action is a small server-rendered form carrying the CSRF token,
   so the whole screen works with no JavaScript.

   `kinds`, `selected`, `editingBlocks`, `blockCatalogue`, `moneyDirections`,
   `colourKeys`, `csrfToken`, `area` are supplied by IncidentTaxonomyController.
   ========================================================================== #}
{% set activeKinds = kinds|filter(k => k.active)|length %}
{% set retiredKinds = kinds|length - activeKinds %}
<div class="tx-mgr">
  <div class="tx-kinds">
    <div class="tx-pane-hd"><b>Kinds</b><span class="tx-scope">{{ ux_icon('incident:map-pin', {width: 11, height: 11}) }}{{ area.name }}</span><span class="cnt" style="margin-left:9px">{{ activeKinds }}{% if retiredKinds %} &middot; {{ retiredKinds }} retired{% endif %}</span></div>

    {% for kind in kinds %}
      <a class="tx-kind{{ kind is same as(selected) ? ' on' }}{{ not kind.active ? ' off' }}" href="{{ path('incident_kinds', {uuid: area.uuid, kind: kind.uuid}) }}">
        <span class="grip">{{ ux_icon('shell:grip-vertical', {width: 11, height: 11}) }}</span>
        <span class="dot" style="{{ kind.active ? 'background:var(--i-' ~ kind.colourKey ~ ')' }}"></span>
        <span class="nm">{{ kind.label }}<em>{{ kind.code }}</em></span>
        <span class="n">{{ kind.activeSubcategoryCount }} subs</span>
      </a>
    {% endfor %}

    {# → POST …/taxonomy/kinds {label, colour} — the empty-start "write the first
       kind" path reaches the same endpoint. #}
    <form class="tx-form" method="post" action="{{ path('incident_kinds_kind_create', {uuid: area.uuid}) }}" style="padding:11px 13px;gap:7px;border-top:1px dashed color-mix(in srgb,var(--fog) 28%,transparent)">
      <input type="hidden" name="_token" value="{{ csrfToken }}">
      <input class="tx-input" type="text" name="label" placeholder="New kind of incident" required style="flex:1">
      <select class="tx-input" name="colour" aria-label="Colour">
        {% for key in colourKeys %}<option value="{{ key }}">{{ key }}</option>{% endfor %}
      </select>
      <button class="tx-cta" type="submit">{{ ux_icon('shell:plus', {width: 13, height: 13}) }} Add</button>
    </form>
  </div>

  <div class="tx-detail">
    {% set kindActiveSubs = selected.subcategories|filter(s => s.active)|length %}
    {% set kindRetiredSubs = selected.subcategories|length - kindActiveSubs %}
    <div class="tx-khead">
      <div class="bd">
        <h3>{{ selected.label }}</h3>
        <div class="meta">
          <span class="tx-code locked">{{ selected.code }}</span>
          <span class="i-cat {{ selected.colourKey }}"><i></i>{{ selected.colourKey }}</span>
        </div>
        {# → PATCH …/kinds/{uuid} {label} — the wire-code never changes #}
        <form class="tx-form" method="post" action="{{ path('incident_kinds_kind_rename', {uuid: area.uuid, kind: selected.uuid}) }}" style="margin-top:10px">
          <input type="hidden" name="_token" value="{{ csrfToken }}">
          <input class="tx-input" type="text" name="label" value="{{ selected.label }}" aria-label="Rename this kind" required>
          <button class="tx-act" type="submit">{{ ux_icon('incident:pencil', {width: 12, height: 12}) }} Rename</button>
        </form>
      </div>
      <div class="acts">
        {# → POST …/kinds/{uuid}/deactivate — informative, never a guard #}
        {% if selected.active %}
          <form class="tx-actform" method="post" action="{{ path('incident_kinds_kind_deactivate', {uuid: area.uuid, kind: selected.uuid}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <button class="tx-act warn" type="submit">{{ ux_icon('incident:power', {width: 12, height: 12}) }} Deactivate</button>
          </form>
        {% else %}
          <form class="tx-actform" method="post" action="{{ path('incident_kinds_kind_reactivate', {uuid: area.uuid, kind: selected.uuid}) }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <button class="tx-act" type="submit">{{ ux_icon('shell:rotate-ccw', {width: 12, height: 12}) }} Reactivate</button>
          </form>
        {% endif %}
      </div>
    </div>

    <div class="tx-subs">
      <div class="tx-pane-hd" style="border-top:0"><b>Sub-categories</b><span class="cnt">{{ kindActiveSubs }}{% if kindRetiredSubs %} &middot; {{ kindRetiredSubs }} retired{% endif %}</span></div>

      {% for sub in selected.subcategories %}
        <div class="tx-sub{{ not sub.active ? ' off' }}">
          <span class="grip">{{ ux_icon('shell:grip-vertical', {width: 11, height: 11}) }}</span>
          <div class="bd">
            <div class="nm"><b>{{ sub.label }}</b><span class="tx-code locked">{{ sub.code }}</span>{% if not sub.active %} <span class="tx-retired">retired</span>{% endif %}</div>
            <div class="blocks">
              {% for block in sub.blocks %}
                <span class="tx-blk {{ block.isMoney ? 'money' : 'on' }}">{{ block.label }}{% if block.isMoney and sub.moneyDirection %} &middot; {{ sub.moneyDirection.value }}{% endif %}</span>
              {% else %}
                <span class="tx-blk none">no blocks yet</span>
              {% endfor %}
            </div>
          </div>
          <div class="acts">
            {# → the block editor opens on the same route, ?blocks={uuid} #}
            <a class="tx-act" href="{{ path('incident_kinds', {uuid: area.uuid, kind: selected.uuid, blocks: sub.uuid}) }}#blocks-{{ sub.uuid }}">{{ ux_icon('incident:pen-line', {width: 12, height: 12}) }} Edit blocks</a>
            {% if sub.active %}
              <form class="tx-actform" method="post" action="{{ path('incident_kinds_sub_deactivate', {uuid: area.uuid, sub: sub.uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <button class="tx-act warn" type="submit">{{ ux_icon('incident:power', {width: 12, height: 12}) }} Deactivate</button>
              </form>
            {% else %}
              <form class="tx-actform" method="post" action="{{ path('incident_kinds_sub_reactivate', {uuid: area.uuid, sub: sub.uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <button class="tx-act" type="submit">{{ ux_icon('shell:rotate-ccw', {width: 12, height: 12}) }} Reactivate</button>
              </form>
            {% endif %}
          </div>
        </div>

        {# THE COMPOSABLE BEHAVIOUR-BLOCK TOGGLES, opened for this sub. Each block
           is independent — tick what it records. → PUT …/subcategories/{uuid}/blocks #}
        {% if editingBlocks is same as(sub) %}
          <div class="tx-blockedit" id="blocks-{{ sub.uuid }}">
            <form method="post" action="{{ path('incident_kinds_sub_blocks', {uuid: area.uuid, sub: sub.uuid}) }}">
              <input type="hidden" name="_token" value="{{ csrfToken }}">
              <div class="tx-picker">
                <div class="hd"><b>{{ sub.label }} &mdash; this sub-category also records</b><em>each block is independent &mdash; tick what it asks for</em></div>
                <div class="tx-toggles">
                  {% for block in blockCatalogue %}
                    <label class="tx-tog{{ sub.hasBlock(block) ? ' on' }}">
                      <input type="checkbox" name="blocks[]" value="{{ block.value }}"{{ sub.hasBlock(block) ? ' checked' }}>
                      <span class="box">{{ ux_icon('shell:check', {width: 10, height: 10}) }}</span>
                      <span class="bd"><b>{{ block.label }}</b><em>{{ block.description }}</em></span>
                    </label>
                  {% endfor %}
                </div>
              </div>
              <div class="tx-savebar">
                <label class="tx-meta" for="money-dir-{{ sub.uuid }}">Money runs as</label>
                <select class="tx-input" id="money-dir-{{ sub.uuid }}" name="money_direction">
                  <option value="">— not decided —</option>
                  {% for dir in moneyDirections %}<option value="{{ dir.value }}"{{ sub.moneyDirection is same as(dir) ? ' selected' }}>{{ dir.value }}</option>{% endfor %}
                </select>
                <button class="tx-cta" type="submit">{{ ux_icon('shell:check', {width: 13, height: 13}) }} Save blocks</button>
                <a class="tx-act" href="{{ path('incident_kinds', {uuid: area.uuid, kind: selected.uuid}) }}">Cancel</a>
              </div>
            </form>
          </div>
        {% endif %}
      {% endfor %}

      {# → POST …/kinds/{uuid}/subcategories {label} #}
      <form class="tx-form" method="post" action="{{ path('incident_kinds_sub_create', {uuid: area.uuid, kind: selected.uuid}) }}" style="padding:13px 18px">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <input class="tx-input" type="text" name="label" placeholder="New sub-category under {{ selected.label }}" required style="flex:1">
        <button class="tx-cta" type="submit">{{ ux_icon('shell:plus', {width: 13, height: 13}) }} Add sub-category</button>
      </form>
    </div>
  </div>
</div>
