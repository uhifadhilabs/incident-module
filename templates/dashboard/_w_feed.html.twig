{# IN·07 — newest first, grouped by day, with each day's own count. Reads like a
   radio log, which is what a duty officer on shift actually wants. #}
{% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
{# An overview card never grows with the data: the feed shows only the latest
   {{ feedCap }} incidents, grouped by day, and states "latest N of M" beside its
   title — the same cap idiom the register carries. #}
{% set feedCap = 14 %}
<div class="c" data-w="feed">
    <span class="tab">Incident feed<span class="src">· newest first · grouped by day{% if dashboard.recentTotal > feedCap %} · latest {{ feedCap }} of {{ dashboard.recentTotal }}{% endif %}</span></span>
    {{ include('@UhifadhiIncident/dashboard/_filters.html.twig') }}
    {% for day in dashboard.recentByDay(feedCap) %}
        {% set stillOpen = day.incidents|filter(i => i.status.isOpen)|length %}
        <div class="i-day"><b>{{ day.day|date('j M')|lower }}</b><span class="cnt">{{ day.incidents|length }} filed · {{ stillOpen }} still open</span></div>
        {% for incident in day.incidents %}
            <a class="i-feed" href="{{ path('incident_show', {uuid: area.uuid, reference: incident.reference}) }}">
                <span class="gut"><span class="hm">{{ incident.reportedAt|date('H:i') }}</span><span class="ago">{{ incident.ageInHours(dashboard.now) }} h ago</span></span>
                <span class="mark"><i class="i-hue-{{ incident.kind.colourKey }}"></i></span>
                <span class="bd">
                    <span class="hl">{{ ui.id(incident.reference) }}{{ ui.cat(incident.kind, incident.subcategory.label) }}{{ ui.status(incident.status) }}</span>
                    <span class="tt">{{ incident.headline }}</span>
                    <span class="mt">{{ ui.zone(incident) }}<span>{{ incident.source.badge }}</span>{% if incident.sourceRecordLabel %}<span>{{ incident.sourceRecordLabel }}</span>{% endif %}</span>
                </span>
                <span class="rt"><span class="open-btn">Open →</span></span>
            </a>
        {% endfor %}
    {% else %}
        <div class="use">Nothing came in during this window.</div>
    {% endfor %}
</div>
