{# ============================================================================
   THE CHART DRAWING LAYER — one macro per chart shape, each fed PLAIN DATA and
   emitting the SVG.

   Nothing here knows what an incident is. A macro is handed a series, a set of
   segments or a set of bars, with the labels already resolved, and it draws the
   line, the donut or the bars in the host's `.ch` vocabulary. The geometry — the
   axis, the coordinates, the arc lengths, the bar heights — is computed here, so
   the widget partials that call these stay thin: they fetch the numbers and hand
   them over.

   THIS FILE IS MEANT TO BE LIFTED. There is a standing ruling that the incident
   charts be built so a future shared charts-module can take them whole (it will
   behave like the map-module the surface already rides). Keeping the arithmetic
   in one data-agnostic place, in the classes the host already ships, is what
   makes that a move rather than a rewrite. Until then it lives with the module
   that first needed it.
   ========================================================================== #}

{# A LINE + AREA over an evenly-spaced series.

   @param series list of {label, value, title} — one point per step, in order.
   The axis tops out at the next ten above the data; the last point is marked. #}
{% macro line(series) %}
    {% set peak = 0 %}
    {% for point in series %}{% set peak = max(peak, point.value) %}{% endfor %}
    {% set axisMax = peak <= 0 ? 10 : ((peak / 10)|round(0, 'ceil')) * 10 %}
    {% set count = series|length %}
    {% set step = count > 1 ? (455 - 40) / (count - 1) : 0 %}
    {% set unit = 130 / axisMax %}

    {% set points = [] %}
    {% for point in series %}
        {% set points = points|merge([{
            x: (40 + loop.index0 * step)|round(1),
            y: (150 - point.value * unit)|round(1),
            label: point.label,
            value: point.value,
            title: point.title,
            last: loop.last,
        }]) %}
    {% endfor %}

    {% set fill = 'M' ~ points|first.x ~ ',150' %}
    {% set line = '' %}
    {% for point in points %}
        {% set fill = fill ~ ' L' ~ point.x ~ ',' ~ point.y %}
        {% set line = line ~ (loop.first ? 'M' : ' L') ~ point.x ~ ',' ~ point.y %}
    {% endfor %}
    {% set fill = fill ~ ' L' ~ points|last.x ~ ',150 Z' %}

    <svg class="ch" viewBox="0 0 470 180" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Filings over time">
        {% for tick in range(10, axisMax, 10) %}
            {% set ty = (150 - tick * unit)|round(1) %}
            <line class="grid" x1="40" y1="{{ ty }}" x2="458" y2="{{ ty }}"/>
        {% endfor %}
        <line class="ax" x1="40" y1="150" x2="458" y2="150"/>
        {% for tick in range(10, axisMax, 10) %}
            <text x="34" y="{{ (150 - tick * unit + 3)|round(1) }}" text-anchor="end">{{ tick }}</text>
        {% endfor %}
        <path class="lnfill" d="{{ fill }}"/>
        <path class="ln" d="{{ line }}"/>
        {% for point in points %}
            <circle class="dot" cx="{{ point.x }}" cy="{{ point.y }}" r="{{ point.last ? 3 : 2.4 }}"><title>{{ point.title }}</title></circle>
        {% endfor %}
        <text class="anno" x="{{ (points|last.x - 3)|round(1) }}" y="{{ (points|last.y - 6)|round(1) }}" text-anchor="end">{{ points|last.value }}</text>
        {% for point in points %}
            <text x="{{ point.x }}" y="168" text-anchor="middle">{{ point.label }}</text>
        {% endfor %}
    </svg>
{% endmacro %}

{# A DONUT + its own vertical legend over parts of a whole.

   @param segments list of {label, class, count} — biggest first, drawn as arcs.
   @param total    the whole the shares are of; printed at the centre.
   Emits the svg AND the legend; the caller wraps them in a `.ch-donut`. #}
{% macro donut(segments, total) %}
    {% set radius = 54 %}
    {% set circumference = 2 * radius * 3.14159265 %}
    <svg class="ch" viewBox="0 0 160 160" style="max-width:174px" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Share by category">
        <g transform="rotate(-90 80 80)">
            <circle class="track" cx="80" cy="80" r="{{ radius }}"/>
            {% set travelled = 0 %}
            {% for segment in segments %}
                {# The arc is rounded before it is both drawn and carried forward, so
                   an offset is the sum of the arcs actually painted before it — the
                   ring closes on itself to the tenth. #}
                {% set arc = (total > 0 ? segment.count / total * circumference : 0)|round(1) %}
                <circle class="arc {{ segment.class }}" cx="80" cy="80" r="{{ radius }}" stroke-dasharray="{{ arc }} {{ (circumference - arc)|round(1) }}" stroke-dashoffset="{{ travelled > 0 ? '-' ~ travelled : '0' }}"><title>{{ segment.label }}: {{ segment.count }} of {{ total }}</title></circle>
                {% set travelled = (travelled + arc)|round(1) %}
            {% endfor %}
        </g>
        <text class="big" x="80" y="78" text-anchor="middle">{{ total }}</text>
        <text class="annoS" x="80" y="94" text-anchor="middle">incidents</text>
    </svg>
    <div class="legend legend-v">
        {% for segment in segments %}
            <span><i class="{{ segment.class }}"></i>{{ segment.label }}<b>{{ segment.count }}</b><em>{{ total > 0 ? (segment.count / total * 100)|round : 0 }}%</em></span>
        {% endfor %}
    </div>
{% endmacro %}

{# VERTICAL BARS, most-important first, opacity fading left to right.

   @param bars list of {label, value, title} — one bar each, in the order drawn.
   Heights are read off the tallest bar; three grid lines quarter the plot. #}
{% macro bars(bars) %}
    {% set peak = 0 %}
    {% for bar in bars %}{% set peak = max(peak, bar.value) %}{% endfor %}
    {% set tallest = peak > 0 ? peak : 1 %}
    {% set count = bars|length %}
    {% set opacityStep = count > 1 ? (0.95 - 0.48) / (count - 1) : 0 %}
    <svg class="ch" viewBox="0 0 470 180" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Counts by severity">
        {% for line in 1..3 %}
            <line class="grid" x1="24" y1="{{ (148 - 128 * line / 4)|round(1) }}" x2="456" y2="{{ (148 - 128 * line / 4)|round(1) }}"/>
        {% endfor %}
        <line class="ax" x1="24" y1="148" x2="456" y2="148"/>
        {% for bar in bars %}
            {% set height = (bar.value / tallest * 128)|round(1) %}
            <rect x="{{ 48 + loop.index0 * 108 }}" y="{{ (148 - height)|round(1) }}" width="60" height="{{ height }}" rx="3" fill="var(--acc)" opacity="{{ (0.95 - loop.index0 * opacityStep)|round(2) }}"><title>{{ bar.title }}</title></rect>
        {% endfor %}
        {% for bar in bars %}
            {% set height = (bar.value / tallest * 128)|round(1) %}
            <text class="anno" x="{{ 78 + loop.index0 * 108 }}" y="{{ (148 - height - 5)|round(1) }}" text-anchor="middle">{{ bar.value }}</text>
        {% endfor %}
        {% for bar in bars %}
            <text x="{{ 78 + loop.index0 * 108 }}" y="164" text-anchor="middle">{{ bar.label }}</text>
        {% endfor %}
    </svg>
{% endmacro %}
