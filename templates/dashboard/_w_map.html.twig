{# IN·03 — where every incident was filed.

   A REAL MAP, not a picture of one: self-hosted Leaflet (`window.L`), fed by the
   incident-map Stimulus controller from a GeoJSON payload. MapLibre is
   deliberately not used anywhere in this deployment.

   THE MARKS MEAN SOMETHING, and the legend says what: hue is the category,
   filled means still open, hollow means resolved or closed, a dashed ring means
   high severity. The same legend renders here, on the map+results plate, and on
   the case file — one macro, three places. #}
{% import '@UhifadhiLabsIncident/dashboard/_ui.html.twig' as ui %}
<div class="c" data-w="map">
    <span class="tab"><span class="idx">IN·03</span>Incident map<span class="src">· one filter drives map AND register</span></span>
    {{ include('@UhifadhiLabsIncident/dashboard/_filters.html.twig') }}
    <div class="viewer"
         {{ stimulus_controller('@uhifadhilabs/incident-module/incident-map', {
             incidents: dashboard.mapPayload,
             boundary: area.geom,
         }) }}></div>
    {{ ui.mapLegend(dashboard.categories) }}
</div>
