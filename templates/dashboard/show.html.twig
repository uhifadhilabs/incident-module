{# ============================================================================
   THE INCIDENTS DASHBOARD for one area.

   THIS PERSON'S OWN COMPOSITION, in their own order; a widget they switched off
   is simply ABSENT — not hidden, not an empty cell. The five design directions
   are PRESETS on this surface, not five screens: the library is where one is
   adopted, copied, and mixed with a widget from another.

   Everything below the header is uhifadhi/widget-module
   (Uhifadhi\Widget\Service\WidgetService), which is why arranging this dashboard
   works exactly as it does on every other surface in the installation.
   ========================================================================== #}
{% extends '@UhifadhiIncident/base.html.twig' %}

{# A PAGE SAYS ONLY WHAT IT IS. The shell's document composes the tab title as
   page — place — brand, so naming the area here would print it twice. #}
{% block title %}Incidents{% endblock %}

{% block shell_page_title %}{{ area.name }} — Incidents{% endblock %}

{% block shell_page_subtitle %}Poaching, human–wildlife conflict, compliance and wildlife mortality — every report
    filed in this area, what state it is in, what it cost and who is on it. One filter drives the map, the register
    and the charts together.{% endblock %}

{% block shell_page_actions %}
    {% if widgetScreens %}
        <a class="tgl w-act" href="{{ path('incident_widgets', {uuid: area.uuid}) }}">{{ ux_icon('lucide:layout-grid') }} Widget library</a>
    {% endif %}
    {% if recordScreens %}
        {# STANDALONE FILING — nothing on this page is the record being filed
           about, so the flow gets the whole page and an address of its own. A
           plain link: no trigger, nothing to dismiss. #}
        <a class="cta" href="{{ path('incident_new', {uuid: area.uuid}) }}">{{ ux_icon('lucide:plus') }} Report incident</a>
    {% endif %}
{% endblock %}

{% block incident_page %}
{# NOTHING OPENS OVER THIS PAGE. The report flow lives on its own route, in the
   container its entry point earned — and this dashboard's Report button is not
   anchored to any record, so it is standalone filing and it navigates to the full
   page. See templates/report/show.html.twig. #}
    {{ include('@UhifadhiIncident/dashboard/_lensbar.html.twig') }}

    {% set widgetContext = {
        area: area,
        now: now,
        dashboard: dashboard,
        filter: filter,
        recordScreens: recordScreens,
        widgetScreens: widgetScreens,
        transitionCsrfToken: transitionCsrfToken,
    } %}

    {# The surface's transition token lives on the grid, so every widget on it —
       the status board today, whatever moves an incident tomorrow — can read one
       token rather than each minting its own. Absent for somebody who may not
       move an incident, and then the board renders read-only. #}
    <div class="w-grid"{% if transitionCsrfToken %} data-incident-csrf="{{ transitionCsrfToken }}"{% endif %}>
        {# A switched-off widget is simply absent — not hidden, not an empty cell. #}
        {% for widget in widgets|filter(w => w.on) %}
            {# w-span-N, never w-N: a bare `w-12` is Tailwind's width utility and
               would render this cell 48px wide (see uhifadhi/widget-module). #}
            <div class="w-cell w-span-{{ widget.cols }}" data-widget-id="{{ widget.id }}" data-widget-cols="{{ widget.cols }}">
                <div class="w-inner">
                    {{ include('@UhifadhiIncident/dashboard/_w_' ~ widget.id ~ '.html.twig', widgetContext, with_context: false) }}
                </div>
            </div>
        {% endfor %}
        {% if widgetScreens %}
            <a class="w-cell w-span-12 w-addtile" href="{{ path('incident_widgets', {uuid: area.uuid}) }}">
                {{ ux_icon('lucide:plus') }}<span>Add widgets — open the library</span>
            </a>
        {% endif %}
    </div>
{% endblock %}
