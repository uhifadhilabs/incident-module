{# ============================================================================
   THE INCIDENTS WIDGET LIBRARY.

   The PAGE is the chrome — a crumb, a header and its two actions. Everything
   below is templates/widgets/_library.html.twig: the HOST's preset component,
   identical on every surface that ships a WidgetCatalog and parameterised by this
   surface's catalogue, partial name and routes. There are no incident-specific
   widget mechanics anywhere.

   AREA-SCOPED: every URL the component is handed names this area, so arranging
   one area's incidents dashboard leaves every other area's alone.
   ========================================================================== #}
{% extends '@UhifadhiIncident/base.html.twig' %}

{% block title %}{{ area.name }} · Incidents · widget library{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# type="module" is deferred by definition, so the library is armed after the
       DOM exists. The script is the HOST's — one library, every surface. #}
    <script type="module">
        import { initWidgetLibrary } from 'uhifadhi/widgets';
        initWidgetLibrary();
    </script>
{% endblock %}

{% block incident_page %}
    <div class="crumb"><a href="{{ path('dashboard_index') }}">uhifadhi</a> / <a href="{{ path('dashboard_area_show', {uuid: area.uuid}) }}">{{ area.name|lower }}</a> / <a href="{{ path('dashboard_area_modules_grid', {uuid: area.uuid}) }}">modules</a> / <a href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">incidents</a> / widget library</div>

    <div class="pghead">
        <div>
            <h1 class="pg">{{ area.name }} · Incidents · widget library</h1>
            <p class="pgsub">Adopt one of the five designs this module ships, or compose your own. Every widget below is
                the real thing at full size, exactly as the dashboard renders it — and the five headed sections are the
                five directions incidents was drawn in.</p>
        </div>
        <div class="pgact w-pgact">
            {# Throwing the whole composition away asks first — through the host's
               reusable confirm-modal controller, never the browser's own dialog. #}
            <button type="button" class="tgl w-act" {{ constant('Uhifadhi\\Model\\WidgetDom::RESET') }}
                    {{ stimulus_controller('confirm-modal') }}
                    data-action="click->confirm-modal#ask"
                    data-confirm-modal-title-value="Reset your widget layout?"
                    data-confirm-modal-message-value="This area's incidents dashboard goes back to the composition the module ships with. Your own presets are kept, and your other areas are untouched."
                    data-confirm-modal-confirm-label-value="Reset layout"
                    data-confirm-modal-danger-value="true">{{ ux_icon('lucide:rotate-ccw') }}Reset to defaults</button>
            <a class="cta" href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">{{ ux_icon('lucide:chevron-left') }}Back to dashboard</a>
        </div>
    </div>

    <div class="i-lensnote">{{ ux_icon('lucide:info') }}<div><b>The directions are presets, not pages.</b> Incidents was
        explored as case files, a map, a feed, a board of counts and a board of statuses. None of them became a separate
        screen: each is a headed section of this catalogue and a preset that composes it. Adopt one, copy it, then pull
        the map out of <b>Map first</b> into your copy of <b>Case files</b> — the directions are ingredients, not a
        ballot.</div></div>

    {{ include('widgets/_library.html.twig', {
        catalog: catalog,
        builtins: builtins,
        customPresets: customPresets,
        active: active,
        widgets: widgets,
        partial: partial,
        widgetContext: widgetContext,
        urls: urls,
        csrfToken: csrfToken,
    }, with_context: false) }}
{% endblock %}
