{# IN·12 — five columns, one per state.

   DRAGGING A CARD BETWEEN COLUMNS *IS* THE TRANSITION. There is no separate
   "change status" form in this direction, and an illegal move refuses: the
   workflow decides what is allowed, never the UI. Without JavaScript every card
   is still a link to its case file, where the same transitions are buttons — the
   board is an accelerator, never the only door.

   → POST /areas/{uuid}/modules/incidents/{reference}/transition/{name} #}
{% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
{# An overview card never grows with the data: each column shows only its newest
   {{ colCap }} cards and closes with a "… and N more this month" ghost when a
   column is deeper — the design's own overflow mark. The count in the column
   header stays the true total. #}
{% set colCap = 6 %}
<div class="c" data-w="board">
    <span class="tab">Status board<span class="src">· {{ transitionCsrfToken ? 'drag a card to move an incident on' : 'read-only — moving needs the manage permission' }}</span></span>
    <div class="i-board"
         {{ stimulus_controller('@uhifadhi/incident-module/incident-board', {
             url: path('incident_transition', {uuid: area.uuid, reference: 'INC-0000', transition: 'verify'}),
             csrf: transitionCsrfToken ?? '',
         }) }}>
        {% for place in dashboard.places %}
            <div class="i-col" data-place="{{ place.value }}">
                <div class="i-colhd">{{ ui.status(place) }}<span class="n">{{ dashboard.statusCount(place) }}</span></div>
                {% for incident in dashboard.column(place)|slice(0, colCap) %}
                    <a class="i-card {{ incident.category.colourKey }}" draggable="true"
                       data-reference="{{ incident.reference }}"
                       href="{{ path('incident_show', {uuid: area.uuid, reference: incident.reference}) }}">
                        {# The age goes red (.old) once the card is past its category's own term. #}
                        <span class="id">{{ incident.reference }}<span class="age{{ incident.ageInHours(dashboard.now) > incident.subcategory.termHours ? ' old' }}">{{ incident.ageInHours(dashboard.now) < 48 ? incident.ageInHours(dashboard.now) ~ ' h' : (incident.ageInHours(dashboard.now) // 24) ~ ' d' }}</span></span>
                        <span class="tt">{{ incident.headline }}</span>
                        {# The footer: responder initials, the sub-category, and the zone chip. #}
                        <span class="ft">{% if incident.assignedTo %}<span class="av">{{ (incident.assignedTo.firstName|slice(0, 1) ~ incident.assignedTo.lastName|slice(0, 1))|upper }}</span>{% endif %}<span>{{ incident.subcategory.label }}</span>{{ ui.zone(incident) }}</span>
                    </a>
                {% endfor %}
                {% if dashboard.statusCount(place) > colCap %}
                    <span class="i-card ghost"><span class="tt i-cardmore">… and {{ dashboard.statusCount(place) - colCap }} more this month</span></span>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>
