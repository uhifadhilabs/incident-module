{# IN·12 — five columns, one per state.

   DRAGGING A CARD BETWEEN COLUMNS *IS* THE TRANSITION. There is no separate
   "change status" form in this direction, and an illegal move refuses: the
   workflow decides what is allowed, never the UI. Without JavaScript every card
   is still a link to its case file, where the same transitions are buttons — the
   board is an accelerator, never the only door.

   → POST /areas/{uuid}/modules/incidents/{reference}/transition/{name} #}
{% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
<div class="c" data-w="board">
    <span class="tab"><span class="idx">IN·12</span>Status board<span class="src">· {{ transitionCsrfToken ? 'drag a card to move an incident on' : 'read-only — moving needs the manage permission' }}</span></span>
    <div class="i-board"
         {{ stimulus_controller('@uhifadhi/incident-module/incident-board', {
             url: path('incident_transition', {uuid: area.uuid, reference: 'INC-0000', transition: 'verify'}),
             csrf: transitionCsrfToken ?? '',
         }) }}>
        {% for place in dashboard.places %}
            <div class="i-col" data-place="{{ place.value }}">
                <div class="i-colhd">{{ ui.status(place) }}<span class="n">{{ dashboard.statusCount(place) }}</span></div>
                {% for incident in dashboard.column(place) %}
                    <a class="i-card {{ incident.category.colourKey }}" draggable="true"
                       data-reference="{{ incident.reference }}"
                       href="{{ path('incident_show', {uuid: area.uuid, reference: incident.reference}) }}">
                        <span class="id">{{ incident.reference }}<span class="age">{{ incident.ageInHours(dashboard.now) < 48 ? incident.ageInHours(dashboard.now) ~ ' h' : (incident.ageInHours(dashboard.now) // 24) ~ ' d' }}</span></span>
                        <span class="tt">{{ incident.headline }}</span>
                        <span class="mt">{{ incident.subcategory.label }} · {{ incident.zoneLabel }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
