{# IN·04 — the map at full height with the matching incidents docked beside it, so
   "where" is answered before "what".

   The list follows the SAME filter the map draws — the two are one query read
   twice, never two queries that might disagree. #}
{% import '@UhifadhiIncident/dashboard/_ui.html.twig' as ui %}
<div class="c" data-w="maplist">
    <span class="tab">Map + results<span class="src">· the list follows the filter</span></span>
    {{ include('@UhifadhiIncident/dashboard/_filters.html.twig') }}
    <div class="i-split">
        <div class="i-mapcol">
            {# The atlas's plate, exactly as the map widget wires it: the layers,
               their hues and the legend are stated in PHP. #}
            {{ render_map(dashboard.map, {'role': 'img', 'aria-label': 'Where every incident in this view was filed'}) }}
        </div>
        <div class="i-listcol">
            {# The docked results are .i-hit rows (host vocabulary, shared with the
               area overview's split): a header naming how many are in view, then a
               scrolling body of three-line hits — id + kind + status, the headline,
               then zone + when. #}
            <div class="i-listhd">In this view<span class="n">{{ dashboard.recent|slice(0, 14)|length }} of {{ dashboard.recentTotal }}</span></div>
            <div class="i-listbody">
                {% for incident in dashboard.recent|slice(0, 14) %}
                    {# Hovering a hit spotlights its own mark on the plate beside
                       it and pushes the others back. The attribute is the whole
                       of the wiring: the atlas's plate answers it, and this
                       module ships no map JavaScript for it. #}
                    <a class="i-hit" href="{{ path('incident_show', {uuid: area.uuid, reference: incident.reference}) }}"
                       data-atlas-highlight="incident.{{ incident.kind.code }}:{{ incident.reference }}">
                        <span class="r1"><span class="id">{{ incident.reference }}</span>{{ ui.cat(incident.kind, incident.subcategory.label) }}{{ ui.status(incident.status) }}</span>
                        <span class="r2">{{ incident.headline }}</span>
                        <span class="r3">{{ ui.zone(incident) }}{{ ui.when(incident.reportedAt, dashboard.now) }}</span>
                    </a>
                {% else %}
                    <div class="use">Nothing matches this filter.</div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
