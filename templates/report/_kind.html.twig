{# STEP 1 — WHAT KIND OF INCIDENT. The first of the three answers a report cannot
   be filed without.

   THE DESIGN'S CARDS, each naming the sub-categories under it — the full page has
   room for them, so nothing has to hide. Choosing a kind selects its FIRST
   sub-category; step 2 then offers the siblings, exactly as the design draws it.

   Parameters: controller, kinds, chosen
   ========================================================================== #}
<div class="i-catpick">
    {% for kind in kinds %}
        {% set codes = [] %}
        {% for sub in kind.subcategories %}{% set codes = codes|merge([sub.code]) %}{% endfor %}
        {% set lit = chosen and chosen.kind.code == kind.code %}
        <label class="i-catopt{{ lit ? ' on' }}"
               {{ stimulus_target(controller, 'category')|stimulus_action(controller, 'choose', 'click') }}
               data-subcategory="{{ codes|first }}"
               data-subcategories="{{ codes|join(',') }}">
            <span class="r"><i class="i-hue-{{ kind.colourKey }}"></i><b>{{ kind.label }}</b></span>
            <span class="d">{% for sub in kind.subcategories %}{{ sub.label }}{{ not loop.last ? ' · ' }}{% endfor %}</span>
        </label>
    {% endfor %}
</div>