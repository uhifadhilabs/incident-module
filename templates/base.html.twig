{# Bundle base: the host's shell plus the incidents module's own stylesheet.
   Every incidents page extends this rather than the host layout directly, so the
   module's vocabulary loads ONLY where the module renders — the host's own
   stylesheet never mentions incidents. #}
{% extends 'layout.html.twig' %}

{# Symfony docs — https://symfony.com/doc/current/frontend/asset_mapper.html :
   "All bundles that have a Resources/public/ or public/ directory will
   automatically have that directory added as an asset path, using the namespace:
   bundles/<BundleName>" — and under AssetMapper those assets are automatically
   content-versioned. So public/incidents.css is served as
   bundles/uhifadhiincident/incidents.css with a digest, no assets:install. #}
{% block stylesheets %}
    {{ parent() }}
    {# Leaflet FIRST, so incidents.css can restyle its controls into the design's
       pills. Both files come from uhifadhi/map-module, by its own constants —
       never a CDN, and the same Leaflet the host's area map runs on, so an
       incident map and an area map cannot disagree about how a layer draws.
       MapLibre is deliberately NOT used. #}
    <link rel="stylesheet" href="{{ asset(constant('Uhifadhi\\Map\\UhifadhiMapBundle::LEAFLET_CSS')) }}">
    {# The path is the bundle's own constant, not a literal: the area overview is
       rendered by the HOST, which links this same sheet from the contributor's
       stylesheet() — and a path typed twice is a path that eventually differs. #}
    <link rel="stylesheet" href="{{ asset(constant('Uhifadhi\\Incident\\UhifadhiIncidentBundle::STYLESHEET')) }}">
{% endblock %}

{% block javascripts %}
    {# A classic <script> in <head> runs before the deferred importmap modules,
       so `window.L` is there by the time a Stimulus controller connects. #}
    <script src="{{ asset(constant('Uhifadhi\\Map\\UhifadhiMapBundle::LEAFLET_JS')) }}"></script>
    {{ parent() }}
{% endblock %}

{# The host layout expects each page to supply its own `.page` container (the
   max-width + side padding wrapper the built-in pages use). Provide it once here
   so every incidents page inherits the same margins; pages fill `incident_page`. #}
{% block content %}
    <div class="page">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="c i-flash" data-incident-flash="{{ label }}"><span class="acc">✓</span> {{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block incident_page %}{% endblock %}
    </div>
{% endblock %}
