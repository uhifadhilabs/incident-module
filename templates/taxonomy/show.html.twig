{# ============================================================================
   THE AREA-SCOPED INCIDENT TAXONOMY ADMIN — the design's taxonomy.html, ported.

   ONE ROUTE, TWO DATA CONDITIONS on the same address:
     · POPULATED — the two-pane manager (_manager.html.twig): kinds on the left,
       the selected kind's sub-categories and their behaviour blocks on the right.
     · EMPTY — the first-run start (_empty.html.twig): the ghost sketch of a
       taxonomy's shape and the "write the first kind" path.

   AREA SCOPE, said once at the top and true of every read and write below: this
   list is THIS area's own, and nothing here is shared with another area.
   ========================================================================== #}
{% extends '@UhifadhiIncident/base.html.twig' %}

{% block title %}Incident taxonomy{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# The taxonomy admin's own `tx-` vocabulary, by the bundle's own constant so
       the path is never typed twice. Loaded only on this screen. #}
    <link rel="stylesheet" href="{{ asset(constant('Uhifadhi\\Incident\\UhifadhiIncidentBundle::TAXONOMY_STYLESHEET')) }}">
{% endblock %}

{% block incident_trail_tail %} <a href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">incidents</a> / taxonomy{% endblock %}

{% block shell_page_title %}{{ area.name }} &mdash; incident taxonomy{% endblock %}

{% block shell_page_subtitle %}The kinds of incident <b>this area</b> files, the sub-categories under each, and &mdash;
    per sub-category &mdash; which of the platform&rsquo;s coded behaviours it switches on. Every area writes its
    own; nothing here is shared with another area, and nothing ships filled in. Rows can be created, renamed and
    retired &mdash; <b>never deleted</b>, because incidents are filed against them and a case file must never lose
    the words that describe it.{% endblock %}

{% block shell_page_actions %}
    <a class="cta" href="{{ path('incident_dashboard', {uuid: area.uuid}) }}">{{ ux_icon('shell:chevron-left', {width: 15, height: 15}) }} Back to dashboard</a>
{% endblock %}

{% block incident_page %}
    {# Area scope, said once, plainly — the one fact that changes how the page is
       read: the list is this area's. #}
    <div class="tx-say">{{ ux_icon('incident:shield', {width: 17, height: 17}) }}<div><b>This taxonomy is {{ area.name }}&rsquo;s own.</b>
        Each area keeps its own kinds and sub-categories, so a change here reaches only the people filing incidents in
        {{ area.name }}. Editing rides on <span class="mono">incidents.manage</span> &mdash; the same authority that moves a
        case through verification and settles the money on it. Filing an incident is not enough to name the kinds of case.</div></div>

    {% if kinds is empty %}
        {{ include('@UhifadhiIncident/taxonomy/_empty.html.twig') }}
    {% else %}
        {{ include('@UhifadhiIncident/taxonomy/_manager.html.twig') }}
    {% endif %}
{% endblock %}
