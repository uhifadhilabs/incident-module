{
    "name": "uhifadhi/incident-module",
    "description": "Incidents: what happened in an area — poaching, human–wildlife conflict (with fines and compensation), unauthorized construction and roadkill, as one record type served to every department that needs it.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux",
        "incidents",
        "poaching",
        "human-wildlife-conflict",
        "conservation",
        "symfony",
        "uhifadhi"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.5",
        "fundistadi/postgis-bundle": "^0.5",
        "php": ">=8.4",
        "symfony/asset": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/ux-icons": "^3.4",
        "uhifadhi/map-module": "dev-main",
        "uhifadhi/module-contracts": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Incident\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Incident\\Tests\\": "tests/",
            "Uhifadhi\\Entity\\": "tests/Fixtures/Uhifadhi/Entity/",
            "Uhifadhi\\Exception\\": "tests/Fixtures/Uhifadhi/Exception/",
            "Uhifadhi\\Model\\": "tests/Fixtures/Uhifadhi/Model/",
            "Uhifadhi\\Module\\": "tests/Fixtures/Uhifadhi/Module/",
            "Uhifadhi\\Overview\\": "tests/Fixtures/Uhifadhi/Overview/",
            "Uhifadhi\\Repository\\": "tests/Fixtures/Uhifadhi/Repository/",
            "Uhifadhi\\Service\\": "tests/Fixtures/Uhifadhi/Service/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/css-selector": "^7.3 || ^8.0",
        "symfony/security-bundle": "^7.3 || ^8.0",
        "symfony/security-core": "^7.3 || ^8.0",
        "symfony/security-csrf": "^7.3 || ^8.0",
        "symfony/security-http": "^7.3 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^2.30 || ^2.0",
        "uhifadhi/storage-module": "dev-main"
    },
    "suggest": {
        "uhifadhi/storage-module": "To put an incident’s evidence on the platform’s Files hub (/files). Register the bundle and IncidentFileSource registers itself; without it, incidents simply do not appear there."
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "module-contracts",
            "type": "vcs",
            "url": "https://github.com/uhifadhilabs/module-contracts"
        },
        {
            "type": "vcs",
            "url": "https://github.com/uhifadhilabs/storage-module"
        },
        {
            "name": "map-module",
            "type": "vcs",
            "url": "https://github.com/uhifadhilabs/map-module"
        }
    ]
}
